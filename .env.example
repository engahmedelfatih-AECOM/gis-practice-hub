# ---------------------------------------------------------------------------
# Copy to .env.local for development. Never commit real values.
# Production values come from the platform secret store (e.g. Azure Key Vault).
# ---------------------------------------------------------------------------

# PostgreSQL connection for the application (least-privilege role in prod).
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/gh_dev

# Shared-instance mode (optional): create and use this database on the DATABASE_URL instance.
HUB_DATABASE_NAME=

# Public origin of the application (used for cookies, redirects, CSRF origin checks).
APP_URL=http://localhost:3000

# 32+ random bytes, base64. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-generate-a-real-secret-before-running

# info | debug | warn | error
LOG_LEVEL=info

# Development only: the seed script creates this Administrator if no users exist.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_NAME="Local Administrator"
SEED_ADMIN_PASSWORD=ChangeMe-Local-Only-123!

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Microsoft Entra ID sign-in. Register a web app in the tenant with redirect URI
# <APP_URL>/api/auth/oauth2/callback/microsoft-entra-id and the openid, profile, email scopes.
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=

# Shared secret for scheduler calls under /api/jobs (x-job-token header), 16+ characters.
JOB_TOKEN=
