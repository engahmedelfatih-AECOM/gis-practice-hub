{
  "name": "gis-practice-hub",
  "version": "0.1.0",
  "private": true,
  "description": "GIS Practice Hub: projects, packages, schema tracking, resources, updates, risks, RFIs and QA/QC for the AECOM Middle East GIS Practice.",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:int": "vitest run --project integration",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:studio": "drizzle-kit studio",
    "verify": "npm run lint && npm run typecheck && npm run test",
    "demo:accounts": "tsx scripts/demo-accounts.ts"
  },
  "dependencies": {
    "better-auth": "1.7.11",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "0.45.4",
    "exceljs": "^4.4.0",
    "jszip": "3.10.1",
    "lucide-react": "^1.59.0",
    "maplibre-gl": "^6.16.0",
    "next": "16.4.2",
    "pdf-lib": "^1.17.1",
    "pino": "10.4.0",
    "postgres": "3.4.9",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "5.0.5",
    "dotenv": "^18.0.8",
    "drizzle-kit": "0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "eslint-plugin-boundaries": "^7.2.0",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "5.0.5"
  }
}
